{
  "name": "@delta-trophies/api",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise catalogue and lead-management API for Delta Industries",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "catalog:seed": "tsx scripts/seed-catalog.ts",
    "catalog:import": "tsx scripts/import-cloudinary-catalog.ts",
    "catalog:replace": "tsx scripts/replace-catalog.ts",
    "catalog:export": "tsx scripts/export-catalogue.ts",
    "catalog:publish": "tsx scripts/export-catalogue.ts --upload",
    "catalog:seo": "tsx scripts/apply-catalog-seo.ts",
    "seo:audit": "tsx scripts/audit-seo.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "multer": "^2.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
